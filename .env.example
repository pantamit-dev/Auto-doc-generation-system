# Copy this file to .env.local and replace each placeholder.
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_or_publishable_key_here

# Server-only secrets. Never expose these through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here
SESSION_SECRET=your_random_session_secret_min_32_bytes_here

# Optional LINE LIFF login configuration.
NEXT_PUBLIC_LIFF_ID=your_liff_id_here
